# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# --- Data ---
# By default we DO NOT commit raw data or intermediate artifacts.
# The manifest is small and IS committed so results are reproducible without redistributing the images.
data/raw/**
data/interim/**
data/processed/patches/**
data/external/**
# But keep the manifest and directory .gitkeep files.
!data/**/.gitkeep
!data/processed/manifests/**

# Model artifacts
checkpoints/
*.pt
*.pth
*.onnx

# Logs
reports/logs/**
!reports/logs/.gitkeep
runs/           # tensorboard
wandb/
mlruns/

# Figures generated by scripts (regenerable)
reports/figures/**
!reports/figures/.gitkeep
