# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# --- Data ---
# By default we DO NOT commit raw data or intermediate artifacts.
# The manifest is small and IS committed so results are reproducible without redistributing the images.
# Paper figures/PDFs are NEVER committed (copyright); only the human-filled meta.yaml is.
data/raw/**
!data/raw/papers/
!data/raw/papers/*/
!data/raw/papers/*/meta.yaml
data/raw/papers/**/*.png
data/raw/papers/**/*.jpg
data/raw/papers/**/*.jpeg
data/raw/papers/**/*.pdf
data/interim/**
data/processed/patches/**
data/external/**
# But keep the manifest, features CSV and directory .gitkeep files.
!data/**/.gitkeep
!data/processed/manifests/**
!data/processed/features/
!data/processed/features/*.csv

# Model artifacts
checkpoints/
*.pt
*.pth
*.onnx

# Logs
reports/logs/**
!reports/logs/.gitkeep
runs/           # tensorboard
wandb/
mlruns/

# Figures generated by scripts (regenerable)
reports/figures/**
!reports/figures/.gitkeep
# Validation report: commit the CSV/markdown, not the plot image.
reports/validation/*.png
